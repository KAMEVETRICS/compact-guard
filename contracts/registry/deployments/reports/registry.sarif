{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "compact-guard",
          "version": "0.1.0",
          "rules": [
            {
              "id": "CG001",
              "name": "Authorization via ownPublicKey()",
              "shortDescription": {
                "text": "Authorization via ownPublicKey()"
              },
              "fullDescription": {
                "text": "ownPublicKey() is a witness: the prover chooses its value, so checks built on it can be bypassed. Authorize by proving knowledge of a secret."
              },
              "helpUri": "https://docs.midnight.network/compact/smart-contract-security#ownpublickey-is-a-witness-function",
              "help": {
                "text": "ownPublicKey() is a witness: the prover chooses its value, so checks built on it can be bypassed. Authorize by proving knowledge of a secret. See https://docs.midnight.network/compact/smart-contract-security#ownpublickey-is-a-witness-function"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CG002",
              "name": "Guessable hash of a low-entropy value",
              "shortDescription": {
                "text": "Guessable hash of a low-entropy value"
              },
              "fullDescription": {
                "text": "Hashing a private value from a small domain (Boolean, enum, small Uint) without randomness lets anyone recover it by hashing every candidate."
              },
              "helpUri": "https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#hashes-and-commitments",
              "help": {
                "text": "Hashing a private value from a small domain (Boolean, enum, small Uint) without randomness lets anyone recover it by hashing every candidate. See https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#hashes-and-commitments"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CG003",
              "name": "Reused or public commitment randomness",
              "shortDescription": {
                "text": "Reused or public commitment randomness"
              },
              "fullDescription": {
                "text": "Commitments that share randomness, or use constant or public randomness, can be linked or opened by observers."
              },
              "helpUri": "https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#randomness-and-rounds-in-commitments",
              "help": {
                "text": "Commitments that share randomness, or use constant or public randomness, can be linked or opened by observers. See https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#randomness-and-rounds-in-commitments"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CG004",
              "name": "Private value used as a public Set/Map key",
              "shortDescription": {
                "text": "Private value used as a public Set/Map key"
              },
              "fullDescription": {
                "text": "Set and Map operations publish their arguments. Membership keyed on private data exposes or links it; a MerkleTree proves membership without revealing which entry."
              },
              "helpUri": "https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#making-use-of-merkle-trees",
              "help": {
                "text": "Set and Map operations publish their arguments. Membership keyed on private data exposes or links it; a MerkleTree proves membership without revealing which entry. See https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#making-use-of-merkle-trees"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CG005",
              "name": "Merkle path not bound to the caller's leaf",
              "shortDescription": {
                "text": "Merkle path not bound to the caller's leaf"
              },
              "fullDescription": {
                "text": "A witness-supplied Merkle path proves that some leaf is in the tree, not that the caller's leaf is, unless the path leaf is checked against a recomputed or trusted value."
              },
              "helpUri": "https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#making-use-of-merkle-trees",
              "help": {
                "text": "A witness-supplied Merkle path proves that some leaf is in the tree, not that the caller's leaf is, unless the path leaf is checked against a recomputed or trusted value. See https://docs.midnight.network/concepts/how-midnight-works/keeping-data-private#making-use-of-merkle-trees"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CG006",
              "name": "Hash without domain separation",
              "shortDescription": {
                "text": "Hash without domain separation"
              },
              "fullDescription": {
                "text": "Hash inputs without a distinct literal domain tag can collide across different uses of the same primitive."
              },
              "helpUri": "https://docs.midnight.network/compact/smart-contract-security#best-practice-use-domain-separation",
              "help": {
                "text": "Hash inputs without a distinct literal domain tag can collide across different uses of the same primitive. See https://docs.midnight.network/compact/smart-contract-security#best-practice-use-domain-separation"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CG007",
              "name": "Whole private aggregate disclosed",
              "shortDescription": {
                "text": "Whole private aggregate disclosed"
              },
              "fullDescription": {
                "text": "disclose() around a whole struct or tuple publishes every field; disclose only the fields that must be public."
              },
              "helpUri": "https://docs.midnight.network/compact/smart-contract-security#best-practice-place-disclose-strategically",
              "help": {
                "text": "disclose() around a whole struct or tuple publishes every field; disclose only the fields that must be public. See https://docs.midnight.network/compact/smart-contract-security#best-practice-place-disclose-strategically"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CG008",
              "name": "One-time action without a nullifier",
              "shortDescription": {
                "text": "One-time action without a nullifier"
              },
              "fullDescription": {
                "text": "A circuit declared one-time has no recognized nullifier absence check followed by insertion, so it can be replayed."
              },
              "helpUri": "https://docs.midnight.network/compact/smart-contract-security#double-spend-prevention-with-nullifiers",
              "help": {
                "text": "A circuit declared one-time has no recognized nullifier absence check followed by insertion, so it can be replayed. See https://docs.midnight.network/compact/smart-contract-security#double-spend-prevention-with-nullifiers"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
