pragma language_version 0.23;
import CompactStandardLibrary;

witness opening(): Bytes<32>;
witness vote(): Boolean;
export ledger first: Bytes<32>;
export ledger second: Bytes<32>;
export circuit publish(): [] {
  const r = opening();
  first = disclose(persistentCommit<Boolean>(vote(), r));
  second = disclose(persistentCommit<Boolean>(vote(), r));
}
